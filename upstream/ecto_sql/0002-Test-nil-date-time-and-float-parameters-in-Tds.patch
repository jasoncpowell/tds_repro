From ab61a2b5a0057bdda973a111603a5e25fad689af Mon Sep 17 00:00:00 2001
From: Jason Powell <jasoncpowell@protonmail.com>
Date: Fri, 18 Sep 2026 13:20:19 -0400
Subject: [PATCH 2/2] Test nil date, time and float parameters in Tds

test/ecto/type_test.exs: the Tds dumpers tag a nil date, time,
datetime and float with the TDS type it is declared as, and leave other
types, non-nil values, arrays and a custom type with a :date primitive
alone.

test/ecto/adapters/tds_test.exs: a nil of each of these types, dumped
through the adapter, is prepared with the parameter type a non-nil
value of the same field gets, or :float for a float, which
prepare_params/1 leaves to the driver. A tagged nil is numbered in
sequence with the other params, a bare nil still goes through untyped,
and update/5 and delete/4 keep comparing a tagged nil filter with
IS NULL.

integration_test/tds/nil_parameters_test.exs: writes nil through
Repo.insert, Repo.update, Repo.insert_all, Repo.update_all and a
type/2 cast for each affected column type, and through a custom type
with a :date primitive on an integer column, whose NULL must stay
untyped.

Co-authored-by: Claude <noreply@anthropic.com>
---
 integration_test/tds/nil_parameters_test.exs | 154 +++++++++++++++++++
 test/ecto/adapters/tds_test.exs              |  46 ++++++
 test/ecto/type_test.exs                      |  49 ++++++
 3 files changed, 249 insertions(+)
 create mode 100644 integration_test/tds/nil_parameters_test.exs

diff --git a/integration_test/tds/nil_parameters_test.exs b/integration_test/tds/nil_parameters_test.exs
new file mode 100644
index 0000000..900b924
--- /dev/null
+++ b/integration_test/tds/nil_parameters_test.exs
@@ -0,0 +1,154 @@
+defmodule Ecto.Integration.NilParametersTest do
+  use ExUnit.Case, async: true
+
+  import Ecto.Migrator, only: [up: 4]
+  import Ecto.Query, only: [from: 2]
+  alias Ecto.Integration.PoolRepo
+
+  defmodule NilParametersMigration do
+    use Ecto.Migration
+
+    # :naive_datetime and :utc_datetime create legacy datetime columns, which
+    # accept an untyped NULL; the typed datetime2 and datetimeoffset NULLs sent
+    # for these fields must be accepted there too.
+    def change do
+      create table(:nil_parameters_test) do
+        add :date_value, :date
+        add :time_value, :time
+        add :time_usec_value, :time_usec
+        add :naive_datetime_value, :naive_datetime
+        add :naive_datetime_usec_value, :naive_datetime_usec
+        add :utc_datetime_value, :utc_datetime
+        add :utc_datetime_usec_value, :utc_datetime_usec
+        add :datetimeoffset_value, :datetimeoffset
+        add :float_value, :float
+        # for IntDate, a custom type with the :date primitive
+        add :int_date_value, :integer
+      end
+    end
+  end
+
+  # A custom type with the :date primitive that stores dates as YYYYMMDD
+  # integers in an int column.
+  defmodule IntDate do
+    use Ecto.Type
+
+    def type, do: :date
+    def cast(%Date{} = date), do: {:ok, date}
+    def load(int), do: {:ok, Date.new!(div(int, 10_000), rem(div(int, 100), 100), rem(int, 100))}
+    def dump(%Date{} = date), do: {:ok, date.year * 10_000 + date.month * 100 + date.day}
+  end
+
+  defmodule NilParameters do
+    use Ecto.Integration.Schema
+
+    schema "nil_parameters_test" do
+      field :date_value, :date
+      field :time_value, :time
+      field :time_usec_value, :time_usec
+      field :naive_datetime_value, :naive_datetime
+      field :naive_datetime_usec_value, :naive_datetime_usec
+      field :utc_datetime_value, :utc_datetime
+      field :utc_datetime_usec_value, :utc_datetime_usec
+      field :datetimeoffset_value, :utc_datetime_usec
+      field :float_value, :float
+      field :int_date_value, IntDate
+    end
+  end
+
+  @values %{
+    date_value: ~D[2024-01-01],
+    time_value: ~T[09:30:00],
+    time_usec_value: ~T[09:30:00.000001],
+    naive_datetime_value: ~N[2024-01-01 09:30:00],
+    naive_datetime_usec_value: ~N[2024-01-01 09:30:00.000001],
+    utc_datetime_value: ~U[2024-01-01 09:30:00Z],
+    utc_datetime_usec_value: ~U[2024-01-01 09:30:00.000001Z],
+    datetimeoffset_value: ~U[2024-01-01 09:30:00.000001Z],
+    float_value: 1.5
+  }
+
+  @int_date ~D[2024-01-01]
+
+  @base_migration 3_000_000
+
+  setup_all do
+    ExUnit.CaptureLog.capture_log(fn ->
+      num = @base_migration + System.unique_integer([:positive])
+      up(PoolRepo, num, NilParametersMigration, log: false)
+    end)
+
+    :ok
+  end
+
+  # SQL Server rejects an untyped (varbinary) NULL for date, time, datetime2,
+  # datetimeoffset and float columns, so apart from the two legacy datetime
+  # columns these only pass when nil is sent as a typed parameter.
+  for field <- Map.keys(@values) do
+    test "updates #{field} to nil" do
+      row = PoolRepo.insert!(struct(NilParameters, @values))
+      changeset = Ecto.Changeset.change(row, [{unquote(field), nil}])
+
+      assert {:ok, _} = PoolRepo.update(changeset)
+      assert PoolRepo.get!(NilParameters, row.id) |> Map.fetch!(unquote(field)) == nil
+    end
+
+    # Ecto drops a nil change on an already-nil field, so the struct starts
+    # with every field set and the changeset clears one.
+    test "inserts nil #{field} over a set field" do
+      changeset = Ecto.Changeset.change(struct(NilParameters, @values), [{unquote(field), nil}])
+
+      assert {:ok, _} = PoolRepo.insert(changeset)
+    end
+
+    test "inserts nil #{field} with insert_all" do
+      assert {1, _} = PoolRepo.insert_all(NilParameters, [%{unquote(field) => nil}])
+    end
+
+    test "sets #{field} to nil with update_all" do
+      row = PoolRepo.insert!(struct(NilParameters, @values))
+      query = from(n in NilParameters, where: n.id == ^row.id)
+
+      assert {1, _} = PoolRepo.update_all(query, set: [{unquote(field), nil}])
+    end
+  end
+
+  test "casts a nil float with type/2" do
+    row = PoolRepo.insert!(struct(NilParameters, @values))
+    value = nil
+
+    query =
+      from(n in NilParameters,
+        where: n.id == ^row.id,
+        update: [set: [float_value: type(^value, :float)]]
+      )
+
+    assert {1, _} = PoolRepo.update_all(query, [])
+  end
+
+  # A custom type with a :date primitive is left alone: Ecto never calls its
+  # dump/1 for nil, so the adapter cannot know that its non-nil values are
+  # stored as integers. Its NULL still reaches the int column untyped, which
+  # SQL Server accepts; a NULL declared as date would be refused.
+  describe "a custom type with a :date primitive on an integer column" do
+    test "updates it to nil" do
+      row = PoolRepo.insert!(struct(NilParameters, Map.put(@values, :int_date_value, @int_date)))
+      assert PoolRepo.get!(NilParameters, row.id).int_date_value == @int_date
+
+      assert {:ok, _} = PoolRepo.update(Ecto.Changeset.change(row, int_date_value: nil))
+      assert PoolRepo.get!(NilParameters, row.id).int_date_value == nil
+    end
+
+    test "inserts nil with insert_all" do
+      assert {1, _} = PoolRepo.insert_all(NilParameters, [%{int_date_value: nil}])
+    end
+
+    test "sets it to nil with update_all" do
+      row = PoolRepo.insert!(struct(NilParameters, Map.put(@values, :int_date_value, @int_date)))
+      query = from(n in NilParameters, where: n.id == ^row.id)
+
+      assert {1, _} = PoolRepo.update_all(query, set: [int_date_value: nil])
+      assert PoolRepo.get!(NilParameters, row.id).int_date_value == nil
+    end
+  end
+end
diff --git a/test/ecto/adapters/tds_test.exs b/test/ecto/adapters/tds_test.exs
index 2e94de1..df44259 100644
--- a/test/ecto/adapters/tds_test.exs
+++ b/test/ecto/adapters/tds_test.exs
@@ -1341,6 +1341,15 @@ defmodule Ecto.Adapters.TdsTest do
     assert query == ~s{DELETE FROM [prefix].[schema] WHERE [x] = @1 AND [y] = @2}
   end
 
+  # Repo.update/2 and Repo.delete/2 pass filters as dumped by the adapter
+  test "update and delete filter a tagged nil with IS NULL" do
+    query = update(nil, "schema", [:x], [{:id, 1}, {:y, {nil, :date}}], [])
+    assert query == ~s{UPDATE [schema] SET [x] = @1 WHERE [id] = @2 AND [y] IS NULL}
+
+    query = delete(nil, "schema", [{:id, 1}, {:y, {nil, :datetimeoffset}}], [])
+    assert query == ~s{DELETE FROM [schema] WHERE [id] = @1 AND [y] IS NULL}
+  end
+
   ## Values List
 
   test "values list: all" do
@@ -2145,6 +2154,43 @@ defmodule Ecto.Adapters.TdsTest do
         SQL.prepare_params([%Tds.Parameter{name: "Param"}])
       end
     end
+
+    test "prepares a dumped nil with the type of a value of the same field" do
+      values = [
+        date: ~D[2024-01-01],
+        time: ~T[09:30:00],
+        time_usec: ~T[09:30:00.000001],
+        naive_datetime: ~N[2024-01-01 09:30:00],
+        naive_datetime_usec: ~N[2024-01-01 09:30:00.000001],
+        utc_datetime: ~U[2024-01-01 09:30:00Z],
+        utc_datetime_usec: ~U[2024-01-01 09:30:00.000001Z],
+        float: 1.5
+      ]
+
+      nil_types = for {type, _value} <- values, do: {type, prepared_type(type, nil)}
+      value_types = for {type, value} <- values, do: {type, prepared_type(type, value)}
+
+      # A float value is left for the driver to type, which makes it :float
+      assert nil_types == Keyword.replace!(value_types, :float, :float)
+    end
+
+    test "numbers a tagged nil param in sequence" do
+      assert SQL.prepare_params([1, {nil, :date}, "a"]) == [
+               %Tds.Parameter{name: "@1", value: 1},
+               %Tds.Parameter{name: "@2", value: nil, type: :date},
+               %Tds.Parameter{name: "@3", value: "a", type: :string}
+             ]
+    end
+
+    test "prepares a bare nil param without a type" do
+      assert SQL.prepare_params([nil]) == [%Tds.Parameter{name: "@1", value: nil, type: nil}]
+    end
+  end
+
+  defp prepared_type(type, value) do
+    {:ok, dumped} = Ecto.Type.adapter_dump(Ecto.Adapters.Tds, type, value)
+    [%Tds.Parameter{type: param_type}] = SQL.prepare_params([dumped])
+    param_type
   end
 
   defp remove_newlines(string) when is_binary(string) do
diff --git a/test/ecto/type_test.exs b/test/ecto/type_test.exs
index 3f18deb..a698210 100644
--- a/test/ecto/type_test.exs
+++ b/test/ecto/type_test.exs
@@ -40,4 +40,53 @@ defmodule Ecto.TypeTest do
     assert adapter_load(Tds, {:map, Elixir.Tds.Ecto.UUID}, %{"a" => @uuid_string}) ==
              {:ok, %{"a" => @uuid_string}}
   end
+
+  # SQL Server refuses the varbinary NULL a bare nil becomes for these columns
+  @tds_tagged_nil_types [
+    date: :date,
+    time: :time,
+    time_usec: :time,
+    naive_datetime: :datetime2,
+    naive_datetime_usec: :datetime2,
+    utc_datetime: :datetimeoffset,
+    utc_datetime_usec: :datetimeoffset,
+    float: :float
+  ]
+
+  test "tags nil with its TDS type for Tds date, time and float types" do
+    for {type, tds_type} <- @tds_tagged_nil_types do
+      assert adapter_dump(Tds, type, nil) == {:ok, {nil, tds_type}}
+    end
+  end
+
+  test "dumps nil as nil for other Tds types" do
+    for type <- [:integer, :boolean, :decimal, :string, :binary, :binary_id, :map] do
+      assert adapter_dump(Tds, type, nil) == {:ok, nil}
+    end
+  end
+
+  test "does not tag non-nil Tds values" do
+    assert adapter_dump(Tds, :date, ~D[2024-01-01]) == {:ok, ~D[2024-01-01]}
+    assert adapter_dump(Tds, :float, 1.5) == {:ok, 1.5}
+  end
+
+  test "leaves nil inside a Tds array to the array dumper" do
+    assert adapter_dump(Tds, {:array, :date}, [nil]) == {:ok, [nil]}
+  end
+
+  defmodule IntDate do
+    use Ecto.Type
+
+    def type, do: :date
+    def cast(%Date{} = date), do: {:ok, date}
+    def load(int), do: {:ok, Date.new!(div(int, 10_000), rem(div(int, 100), 100), rem(int, 100))}
+    def dump(%Date{} = date), do: {:ok, date.year * 10_000 + date.month * 100 + date.day}
+  end
+
+  # Ecto never calls a custom type's dump/1 for nil, so the adapter cannot know
+  # that this type stores its non-nil values as integers.
+  test "does not tag nil for a custom Tds type with a :date primitive" do
+    assert adapter_dump(Tds, IntDate, ~D[2024-01-01]) == {:ok, 20_240_101}
+    assert adapter_dump(Tds, IntDate, nil) == {:ok, nil}
+  end
 end
