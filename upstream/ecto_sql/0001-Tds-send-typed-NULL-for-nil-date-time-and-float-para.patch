From c894718192cd91d00092ebee3cf48f193938be22 Mon Sep 17 00:00:00 2001
From: Jason Powell <jasoncpowell@protonmail.com>
Date: Fri, 18 Sep 2026 13:13:29 -0400
Subject: [PATCH 1/2] Tds: send typed NULL for nil date, time and float params

A bare nil has no type, so the Tds adapter passed it to the driver
untyped and the driver declared it as varbinary. SQL Server refuses to
convert varbinary implicitly to date, time, datetime2, datetimeoffset,
float or real, so clearing such a field failed with error 257 or 206.

Ecto.Adapters.Tds.dumpers/2 now dumps a nil of these Ecto types as a
pair of the nil and the TDS type a non-nil value of the field is sent
as: {nil, :date}, {nil, :time}, {nil, :datetime2},
{nil, :datetimeoffset} or {nil, :float}. It is the same
value-and-driver-type pair that Tds.Ecto.VarChar dumps as
{value, :varchar}, and Ecto.Adapters.Tds.Connection.prepare_params/1
passes it on the same way, so the dumpers stay the place where the Ecto
type is used up. The connection admits only those five TDS types, so a
wrong one fails instead of reaching the driver's varchar fallback. The
driver declares a nil float as decimal(1,0), which SQL Server converts
implicitly to float and real.

Unlike {value, :varchar}, this pair can hold nil, and update/5 and
delete/4 render a nil filter as IS NULL. Both now match the pair too,
so a filter on a nil field still compares with IS NULL and not with a
NULL parameter, which would never be true. They are the only place
where the generated SQL depends on whether a dumped parameter is nil.

The adapter module compiles without the optional tds dependency, so it
cannot build a %Tds.Parameter{} itself; the pair holds only atoms. Only
built-in types are tagged: the dumpers match the Ecto type against its
primitive, so a custom type with one of these primitives, whose non-nil
values may be stored in another representation, keeps sending a bare
nil as before. Other types, including :string on legacy text and ntext
columns, are unchanged.

Ecto.Adapters.SQL.to_sql/3 and the :params metadata of query telemetry
events now contain the pair where they contained nil, and so does the
log line of Ecto.Adapters.SQL.explain/4, which logs the dumped
parameters. Logged parameters of Repo calls are the cast values and
still show nil.

Refs elixir-ecto/tds#124, elixir-ecto/tds#168

Co-authored-by: Claude <noreply@anthropic.com>
---
 lib/ecto/adapters/tds.ex            | 23 +++++++++++++++++++++++
 lib/ecto/adapters/tds/connection.ex | 15 +++++++++++++++
 2 files changed, 38 insertions(+)

diff --git a/lib/ecto/adapters/tds.ex b/lib/ecto/adapters/tds.ex
index 711eae9..02ba75c 100644
--- a/lib/ecto/adapters/tds.ex
+++ b/lib/ecto/adapters/tds.ex
@@ -151,11 +151,34 @@ defmodule Ecto.Adapters.Tds do
   def loaders(:binary_id, type), do: [Tds.Ecto.UUID, type]
   def loaders(_, type), do: [type]
 
+  # The TDS type a nil of these built-in types is sent as. An untyped nil is
+  # declared as varbinary, which date, time, datetime2, datetimeoffset, float
+  # and real columns refuse, so tag_nil/2 pairs it with the type a non-nil
+  # value of the field gets, and the connection passes the pair on like
+  # {value, :varchar}. It holds only atoms, so this module still compiles
+  # without tds. Custom types aren't tagged: Ecto never calls their dump/1 for
+  # nil, so how they store values is unknown. :string is left alone on purpose
+  # (elixir-ecto/tds#162).
+  @tagged_nil_types %{
+    date: :date,
+    time: :time,
+    time_usec: :time,
+    naive_datetime: :datetime2,
+    naive_datetime_usec: :datetime2,
+    utc_datetime: :datetimeoffset,
+    utc_datetime_usec: :datetimeoffset,
+    float: :float
+  }
+
   @impl true
   def dumpers({:map, _}, type), do: [&Ecto.Type.embedded_dump(type, &1, :json)]
   def dumpers(:binary_id, type), do: [type, Tds.Ecto.UUID]
+  def dumpers(type, type) when is_map_key(@tagged_nil_types, type), do: [type, &tag_nil(&1, type)]
   def dumpers(_, type), do: [type]
 
+  defp tag_nil(nil, type), do: {:ok, {nil, Map.fetch!(@tagged_nil_types, type)}}
+  defp tag_nil(value, _type), do: {:ok, value}
+
   defp bool_decode(<<0>>), do: {:ok, false}
   defp bool_decode(<<1>>), do: {:ok, true}
   defp bool_decode(0), do: {:ok, false}
diff --git a/lib/ecto/adapters/tds/connection.ex b/lib/ecto/adapters/tds/connection.ex
index 170b832..fb16d12 100644
--- a/lib/ecto/adapters/tds/connection.ex
+++ b/lib/ecto/adapters/tds/connection.ex
@@ -143,6 +143,13 @@ if Code.ensure_loaded?(Tds) do
     defp prepare_raw_param(value) when value == true, do: {1, :boolean}
     defp prepare_raw_param(value) when value == false, do: {0, :boolean}
     defp prepare_raw_param({_, :varchar} = value), do: value
+
+    # A nil that Ecto.Adapters.Tds.dumpers/2 paired with its TDS type. The
+    # list is the set of values of @tagged_nil_types there.
+    defp prepare_raw_param({nil, type} = value)
+         when type in [:date, :time, :datetime2, :datetimeoffset, :float],
+         do: value
+
     defp prepare_raw_param(value), do: {value, nil}
 
     defp json_library(), do: Application.get_env(:tds, :json_library, Jason)
@@ -291,6 +298,10 @@ if Code.ensure_loaded?(Tds) do
           {field, nil}, acc ->
             {[quote_name(field), " IS NULL"], acc + 1}
 
+          # A nil that Ecto.Adapters.Tds.dumpers/2 paired with its TDS type
+          {field, {nil, _type}}, acc ->
+            {[quote_name(field), " IS NULL"], acc + 1}
+
           {field, _value}, acc ->
             {[quote_name(field), " = @", Integer.to_string(acc)], acc + 1}
 
@@ -315,6 +326,10 @@ if Code.ensure_loaded?(Tds) do
           {field, nil}, acc ->
             {[quote_name(field), " IS NULL"], acc + 1}
 
+          # A nil that Ecto.Adapters.Tds.dumpers/2 paired with its TDS type
+          {field, {nil, _type}}, acc ->
+            {[quote_name(field), " IS NULL"], acc + 1}
+
           {field, _value}, acc ->
             {[quote_name(field), " = @", Integer.to_string(acc)], acc + 1}
 
